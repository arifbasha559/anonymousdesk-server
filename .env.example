# ── Server ──
NODE_ENV=development
PORT=4000

# ── Database (MySQL) ──
# Example: mysql://user:password@localhost:3306/anonymousdesk
DATABASE_URL="mysql://user:password@localhost:3306/anonymousdesk"

# ── Redis (Upstash for production — use the rediss:// TLS URL) ──
# Local dev:  redis://localhost:6379
# Upstash:    rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# ── JWT secrets — MUST be >= 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-real-64-char-random-secret-before-deploying"
JWT_REFRESH_SECRET="replace-with-a-different-64-char-random-secret"
ANON_ID_SALT="replace-with-another-unique-64-char-random-secret"

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

BCRYPT_ROUNDS=12

# ── AI (Google Gemini) ──
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODERATION_MODEL=gemini-1.5-flash
GEMINI_SUMMARY_MODEL=gemini-1.5-pro

# ── CORS — comma-separated list of allowed browser origins.
# Leave empty during development to allow all (mobile apps send no Origin header anyway).
CORS_ORIGINS=""

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

LOG_LEVEL=info
